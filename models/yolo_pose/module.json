{
  "module": "yolo_pose",
  "register": "mipk_yolo_pose_register",
  "capabilities": [
    {
      "kind": "postprocess",
      "name": "yolo_pose",
      "abi_version": 2,
      "implementation_version": "2.0.0",
      "inputs": [
        "tensors"
      ],
      "options": {
        "output_index": {
          "type": "int",
          "min": 0,
          "default": 0
        },
        "keypoint_count": {
          "type": "int",
          "min": 1,
          "max": 256,
          "default": 17
        },
        "score_threshold": {
          "type": "number",
          "min": 0,
          "max": 1,
          "default": 0.5
        },
        "iou_threshold": {
          "type": "number",
          "min": 0,
          "max": 1,
          "default": 0.45
        },
        "max_candidates": {
          "type": "int",
          "min": 1,
          "default": 100
        },
        "max_results": {
          "type": "int",
          "min": 1,
          "max": "result_capacity"
        }
      },
      "output": "results",
      "result_types": [
        "detection",
        "keypoint"
      ],
      "constraints": [
        {
          "le": [
            "max_results",
            "max_candidates"
          ]
        }
      ],
      "compat_version": "2.0.0"
    }
  ]
}
