{
  "module": "classification",
  "register": "mipk_classification_register",
  "capabilities": [
    {
      "kind": "postprocess",
      "name": "classification",
      "abi_version": 2,
      "implementation_version": "2.0.0",
      "inputs": [
        "tensors"
      ],
      "options": {
        "output_index": {
          "type": "int",
          "min": 0,
          "default": 0
        },
        "transform": {
          "type": "string",
          "enum": [
            "probability",
            "sigmoid",
            "softmax"
          ],
          "default": "probability"
        },
        "class_output_indices": {
          "type": "array",
          "items": "int",
          "unique": true
        },
        "score_threshold": {
          "type": "number",
          "min": 0,
          "max": 1
        },
        "top_k": {
          "type": "int",
          "min": 1,
          "max": "result_capacity"
        },
        "max_items": {
          "type": "int",
          "min": 1,
          "max": "result_capacity"
        }
      },
      "output": "results",
      "result_types": [
        "classification"
      ],
      "result_bound_option": "top_k",
      "compat_version": "2.0.0"
    }
  ]
}
